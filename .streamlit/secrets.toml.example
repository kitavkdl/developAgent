# 이 파일은 "템플릿"입니다. 실제 키 값을 채운 secrets.toml은 .gitignore로 커밋에서 제외됩니다.
# 로컬 개발: 이 파일을 복사해서 .streamlit/secrets.toml로 만들고 실제 값을 채우세요.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 배포: Streamlit Cloud 앱 설정 > Secrets 에 이 내용을 그대로 붙여넣고 값만 채우세요.
#   (앱 설정 화면에서 넣은 값은 리포에 올라가지 않습니다.)

OPENAI_API_KEY = "sk-..."
LINER_API_KEY = "..."

# Neon (PostgreSQL + pgvector) 연결 문자열. pooled connection string 사용 권장
DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# LINER 엔드포인트 — MODELS_AND_APIS.md §3.2 (L1) 실측 후 확정할 것. 미확인 상태의 기본값.
LINER_API_BASE = "https://api.liner.com/v1"
LINER_WEB_SEARCH_PATH = "/search/web"
LINER_SCHOLAR_SEARCH_PATH = "/search/scholar"
# L3 실측 결과: 날짜범위 필터 미지원이면 false → 델타 서치 자동 스코프 아웃 (PRD §10-4)
LINER_SUPPORTS_DATE_FILTER = false
LINER_TIMEOUT_SECONDS = 15
LINER_QPS = 1.0

# 모델 ID (MODELS_AND_APIS.md §2.4과 동일한 값. 하드코딩 대신 여기서 관리)
OPENAI_MODEL_INTAKE = "gpt-5.6-terra"
OPENAI_MODEL_TRIAGE = "gpt-5.6-terra"
OPENAI_MODEL_ROUTER = "gpt-5.6-luna"
OPENAI_MODEL_LABELER = "gpt-5.6-luna"
OPENAI_MODEL_HYPOTHESIS = "gpt-5.6-sol"
OPENAI_MODEL_EVALUATOR = "gpt-5.6-sol"
OPENAI_MODEL_GUARDRAIL = "gpt-5.6-luna"
OPENAI_MODEL_REPORTER = "gpt-5.6-terra"
OPENAI_MODEL_EMBEDDING = "text-embedding-3-small"

# 임계값/예산 (DECISIONS.md D-11, D-13 — 전부 미검증 추정치, 실측 후 조정)
JOB_TIMEOUT_SECONDS = 270
CATEGORY_REUSE_THRESHOLD = 0.75
CANONICAL_THRESHOLD = 0.85
DISPUTE_COUNT_THRESHOLD = 3
DISPUTE_RATIO_THRESHOLD = 0.30

# 세컨드 화면 폴링 주기 (초) — Neon 무료 티어 요청 한도 고려
TRACE_POLL_INTERVAL_SECONDS = 1.0
