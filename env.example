# ==========================
# AI Secretary Pro
# Environment Variables
# ==========================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Default Model
OPENAI_MODEL=gpt-4.1-mini

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database
CHROMA_DB_DIR=./vector_db

# Documents
DATA_DIR=./data

# LangSmith (Optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=AI-Secretary-Pro

# Search Tool (Optional)
TAVILY_API_KEY=

# Application
APP_NAME=AI Secretary Pro
APP_ENV=development
LOG_LEVEL=INFO
